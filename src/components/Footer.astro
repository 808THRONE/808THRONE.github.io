---
// Footer.astro
import Logo from './Logo.astro';
---

<footer class="mt-24 border-t border-canvas bg-canvas relative overflow-hidden transition-colors duration-200">
  <!-- Subtle ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[180px] bg-gradient-to-t from-[#ff2a42]/10 to-transparent blur-3xl pointer-events-none"></div>

  <div class="max-w-[1400px] w-full mx-auto px-4 sm:px-8 lg:px-12 py-14 relative z-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-10 border-b border-canvas">
      <!-- Brand & Tagline with new crazy logo -->
      <div class="flex flex-col items-center md:items-start gap-2">
        <Logo size="sm" showText={true} />
        <p class="text-xs text-canvas-muted font-mono tracking-widest uppercase pl-1 pt-1">
          Build &nbsp;/&nbsp; Learn &nbsp;/&nbsp; Create
        </p>
      </div>

      <!-- Quick Nav Links -->
      <nav class="flex items-center gap-8 text-sm font-medium text-canvas-muted">
        <a href="/" class="hover:text-[#ff2a42] transition-colors">Home</a>
        <a href="/blog" class="hover:text-[#ff2a42] transition-colors">Blog</a>
        <a href="/projects" class="hover:text-[#ff2a42] transition-colors">Projects</a>
        <a href="/about" class="hover:text-[#ff2a42] transition-colors">About</a>
      </nav>

      <!-- Social Links with updated real LinkedIn -->
      <div class="flex items-center gap-4">
        <!-- GitHub -->
        <a
          href="https://github.com/808THRONE"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-lg bg-surface border border-canvas text-canvas-muted hover:text-white hover:bg-[#ff2a42] hover:border-[#ff2a42] transition-all shadow-sm"
          aria-label="GitHub Profile"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <!-- LinkedIn (updated URL) -->
        <a
          href="https://www.linkedin.com/in/iheb-brahmi-3a5315369/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-lg bg-surface border border-canvas text-canvas-muted hover:text-white hover:bg-[#ff2a42] hover:border-[#ff2a42] transition-all shadow-sm"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28M7.85 18.5V10.1H5.06v8.4h2.79z" />
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:iheb.brahmi@supcom.tn"
          class="p-2.5 rounded-lg bg-surface border border-canvas text-canvas-muted hover:text-white hover:bg-[#ff2a42] hover:border-[#ff2a42] transition-all shadow-sm"
          aria-label="Send Email"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-canvas-muted gap-4">
      <p>© 2026 THEREDREBEL (Iheb Brahmi • 808THRONE). All rights reserved.</p>
      <p class="flex items-center gap-2 font-mono">
        <span>Tunisia</span>
        <span>•</span>
        <span>SUP'COM ICT Engineer</span>
      </p>
    </div>
  </div>
</footer>
