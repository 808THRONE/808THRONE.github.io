---
// ThemeToggle.astro
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="relative inline-flex items-center justify-center p-2 rounded-lg text-canvas-muted hover:text-[#ff2a42] bg-surface hover:bg-surface-hover transition-all border border-canvas cursor-pointer shadow-sm"
>
  <!-- Sun Icon (visible in dark mode) -->
  <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- Moon Icon (visible in light mode) -->
  <svg id="theme-icon-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script is:inline>
  function applyTheme(theme) {
    const isLight = theme === 'light';
    if (isLight) {
      document.documentElement.classList.add('light');
    } else {
      document.documentElement.classList.remove('light');
    }
    
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    if (sun && moon) {
      if (isLight) {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
      } else {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      }
    }
  }

  // Read initial stored theme or system preference
  const saved = localStorage.getItem('theme');
  const initialTheme = saved ? saved : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  applyTheme(initialTheme);

  // Setup click listener
  document.addEventListener('DOMContentLoaded', () => {
    applyTheme(localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const currentIsLight = document.documentElement.classList.contains('light');
      const nextTheme = currentIsLight ? 'dark' : 'light';
      localStorage.setItem('theme', nextTheme);
      applyTheme(nextTheme);
    });
  });
</script>
