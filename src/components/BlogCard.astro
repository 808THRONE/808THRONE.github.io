---
// BlogCard.astro
interface Props {
  title: string;
  category: string;
  pubDate: Date;
  slug: string;
  image?: string;
  description?: string;
  readingTime?: string;
}

const { title, category, pubDate, slug, image, description, readingTime } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);
---

<article class="flex flex-col bg-surface border border-canvas hover:border-[#ff2a42]/70 rounded-xl overflow-hidden card-hover-effect group shadow-sm">
  {image && (
    <a href={`/blog/${slug}`} class="block relative aspect-[16/9] overflow-hidden bg-surface-muted">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60"></div>
    </a>
  )}

  <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
    <div class="space-y-2.5">
      <!-- Category & Reading time -->
      <div class="flex items-center justify-between text-[11px] font-mono">
        <span class="text-[#ff2a42] font-bold uppercase tracking-wider">{category}</span>
        {readingTime && <span class="text-canvas-muted">{readingTime}</span>}
      </div>

      <!-- Title -->
      <h3 class="text-lg sm:text-xl font-bold text-canvas-text group-hover:text-[#ff2a42] transition-colors leading-snug">
        <a href={`/blog/${slug}`}>
          {title}
        </a>
      </h3>

      {description && (
        <p class="text-sm text-canvas-muted line-clamp-2 leading-relaxed">
          {description}
        </p>
      )}
    </div>

    <!-- Date & Arrow link -->
    <div class="pt-4 border-t border-canvas flex items-center justify-between text-xs text-canvas-muted">
      <time datetime={pubDate.toISOString()} class="font-mono">{formattedDate}</time>
      <a
        href={`/blog/${slug}`}
        class="group-hover:text-[#ff2a42] transition-transform group-hover:translate-x-1 p-1"
        aria-label={`Read ${title}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
