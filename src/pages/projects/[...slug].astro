---
// projects/[...slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | Projects`}
  description={project.data.description}
  image={project.data.image}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-8 lg:px-12 py-12 sm:py-20">
    <!-- Back to projects navigation -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-mono text-canvas-muted hover:text-[#ff2a42] transition-colors cursor-pointer"
      >
        <span>←</span>
        <span>Back to all projects</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="space-y-6 pb-8 border-b border-canvas">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono bg-[#ff2a42]/10 text-[#ff2a42] border border-[#ff2a42]/30 font-semibold uppercase">
        {project.data.category}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-canvas-text tracking-tight leading-tight">
        {project.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-canvas-muted leading-relaxed font-normal">
        {project.data.description}
      </p>

      <!-- Key Metrics Row -->
      {project.data.metrics && project.data.metrics.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
          {project.data.metrics.map((metric: string) => (
            <div class="p-4 rounded-xl bg-surface border border-canvas shadow-sm">
              <span class="text-xs font-mono text-canvas-muted uppercase tracking-wider">Key Result</span>
              <div class="text-sm sm:text-base font-bold text-emerald-400 mt-1">{metric}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Tech Stack & Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4">
        <div class="flex flex-wrap gap-2">
          {project.data.tags.map((tag: string) => (
            <span class="text-xs font-mono text-canvas-text bg-surface-muted px-3 py-1.5 rounded-md border border-canvas">
              {tag}
            </span>
          ))}
        </div>

        {project.data.github && (
          <a
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#ff2a42] hover:bg-[#e01e35] text-white text-xs sm:text-sm font-semibold transition-colors shadow-sm cursor-pointer"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            View Code on GitHub
          </a>
        )}
      </div>
    </header>

    <!-- Project Media (Video or Image) -->
    {project.data.video ? (
      <div class="my-10 rounded-2xl overflow-hidden border border-canvas shadow-lg bg-[#0b0c14]">
        <video
          src={project.data.video}
          controls
          playsinline
          class="w-full aspect-[16/9] object-cover"
        ></video>
      </div>
    ) : project.data.image && (
      <div class="my-10 rounded-2xl overflow-hidden border border-canvas shadow-lg">
        <img
          src={project.data.image}
          alt={project.data.title}
          class="w-full aspect-[16/9] object-cover"
        />
      </div>
    )}

    <!-- Project Case Study Body (Styled via prose.css) -->
    <div class="prose-content pt-4 max-w-none">
      <Content />
    </div>
  </article>

  <script>
    import mermaid from 'mermaid';

    async function renderMermaidDiagrams() {
      const mermaidCodeElements = document.querySelectorAll(
        'pre[data-language="mermaid"], pre > code.language-mermaid, pre.mermaid, code[class*="language-mermaid"]'
      );
      if (!mermaidCodeElements.length) return;

      const isLight = document.documentElement.classList.contains('light');

      mermaid.initialize({
        startOnLoad: false,
        theme: isLight ? 'neutral' : 'dark',
        themeVariables: {
          darkMode: !isLight,
          background: isLight ? '#f8fafc' : '#0b0c14',
          primaryColor: '#ff2a42',
          primaryTextColor: isLight ? '#0f172a' : '#f1f5f9',
          primaryBorderColor: '#ff2a42',
          lineColor: isLight ? '#64748b' : '#94a3b8',
          secondaryColor: isLight ? '#f1f5f9' : '#161926',
          tertiaryColor: isLight ? '#e2e8f0' : '#1a1d2d',
          fontFamily: 'ui-sans-serif, system-ui, -apple-system, sans-serif'
        }
      });

      const targets: HTMLElement[] = [];
      mermaidCodeElements.forEach((el, index) => {
        const pre = el.tagName === 'PRE' ? el : el.closest('pre');
        if (!pre || pre.getAttribute('data-mermaid-processed')) return;
        pre.setAttribute('data-mermaid-processed', 'true');

        const rawCode = el.textContent || '';
        const container = document.createElement('div');
        container.className = 'my-8 p-6 rounded-2xl border border-canvas bg-surface-muted/50 flex flex-col items-center justify-center overflow-x-auto shadow-sm';

        const mermaidDiv = document.createElement('div');
        mermaidDiv.className = 'mermaid w-full flex justify-center text-center';
        mermaidDiv.textContent = rawCode.trim();
        mermaidDiv.id = `mermaid-proj-diagram-${index}`;

        container.appendChild(mermaidDiv);
        pre.replaceWith(container);
        targets.push(mermaidDiv);
      });

      if (targets.length > 0) {
        try {
          await mermaid.run({
            nodes: targets
          });
        } catch (err) {
          console.error('Mermaid render error:', err);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
    } else {
      renderMermaidDiagrams();
    }
  </script>
</BaseLayout>
